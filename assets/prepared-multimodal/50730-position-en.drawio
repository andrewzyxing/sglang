<mxfile host="app.diagrams.net"><diagram name="Prepared input boundary (English)" id="prepared-50730"><mxGraphModel adaptiveColors="auto" page="1" pageWidth="1220" pageHeight="744"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;#50730: common structural checks before model-semantic import&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#2d3142;fillColor=#f5f5f5;strokeColor=#4f5d75;align=left;verticalAlign=middle;spacing=16;strokeColor=none;fillColor=none;fontSize=26;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1160" height="52" as="geometry" /></mxCell><mxCell id="external" value="Outside SGLang: caller / sidecar" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#2d3142;fillColor=#f5f5f5;strokeColor=#4f5d75;align=left;verticalAlign=middle;spacing=16;swimlane;startSize=36;container=1;pointerEvents=0;fillColor=#ececec;strokeColor=#bfc0c0;fontSize=16;spacing=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="280" height="508" as="geometry" /></mxCell><mxCell id="engine" value="Inside SGLang: prepared-input path for the admitted profile" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#2d3142;fillColor=#f5f5f5;strokeColor=#4f5d75;align=left;verticalAlign=middle;spacing=16;swimlane;startSize=36;container=1;pointerEvents=0;fillColor=#ececec;strokeColor=#bfc0c0;fontSize=16;spacing=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="352" y="100" width="848" height="508" as="geometry" /></mxCell><mxCell id="request" value="&lt;b&gt;A multimodal request&lt;/b&gt;&lt;br&gt;&quot;Compare the colors in these images&quot;&lt;br&gt;Text + image A + image B" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#2d3142;fillColor=#f5f5f5;strokeColor=#4f5d75;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="exte